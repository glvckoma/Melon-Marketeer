# Copy this file to .env and fill in what you need. Everything is optional.

# Route bot logins and game connections through an HTTP proxy.
# Strongly recommended: without it the bots use your own IP address.
PROXY_URL=

# Website port (npm run serve)
PORT=3200
# Use a different SQLite file instead of data/marketeer.db
SQLITE_PATH=

# Bot fleet (npm start). AUTO_START=1 logs in accounts and starts scraping without the hub.
AUTO_START=0
AUTO_LOGIN_COUNT=10
LOGIN_STAGGER_MS=4000
